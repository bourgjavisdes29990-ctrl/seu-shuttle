<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f172a"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="东大兰台接驳车"
        android:textColor="#f8fafc"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="桌面小部件 v1.4"
        android:textColor="#64748b"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/widget_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_perm_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 正在检查定位权限..."
            android:textColor="#38bdf8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="开启定位后，小部件将在你位于兰台宿舍附近时自动设为「去上课」，位于九龙湖校区时自动设为「回宿舍」。"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_open_web"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/pill_btn_bg"
        android:text="打开接驳车完整时刻表 🌐"
        android:textColor="#60a5fa"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="返回手机桌面长按空白处，添加「东大接驳车」4×2 卡片"
        android:textColor="#64748b"
        android:textSize="11sp" />

</LinearLayout>
